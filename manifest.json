{
  "manifest_version": 3,
  "key": "",
  "name": "Photoroom",
  "version": "1.0.5",
  "description": "Photoroom Developed by Robitech.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Photoroom"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://photoroomai.onrender.com/*",
    "https://app.photoroom.com/*",
    "https://*.photoroom.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "reader-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.photoroom.com/*"
      ],
      "js": [
        "pack-core.js",
        "reader.js"
      ],
      "css": [
        "view.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://app.photoroom.com/*"
      ]
    }
  ],
  "short_name": "Photoroom"
}